{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.enouia-memory.invalid/memory/import-v1.schema.json",
  "title": "Enouia ImportManifest v1",
  "description": "One user-selected import, a new revision per step (archived, each parse batch, completion) committed with the sources it produced. Raw completeness and parse completeness are separate. Cursor/count consistency, member uniqueness, and coverage closure are checked by the Rust validators.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "import_id",
    "revision",
    "status",
    "input_kind",
    "provider",
    "account_scope",
    "input_object_hash",
    "input_size_bytes",
    "received_at",
    "updated_at",
    "adapter",
    "source_schema_observed",
    "members",
    "cursor",
    "counts",
    "coverage",
    "warnings",
    "duplicate_of",
    "extensions"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common-v1.schema.json#/$defs/schemaVersion"
    },
    "import_id": {
      "$ref": "common-v1.schema.json#/$defs/importId"
    },
    "revision": {
      "$ref": "common-v1.schema.json#/$defs/revision"
    },
    "status": {
      "enum": [
        "planned",
        "archiving",
        "archived",
        "parsing",
        "completed",
        "partial",
        "failed"
      ]
    },
    "input_kind": {
      "enum": [
        "chatgpt_export_zip",
        "chatgpt_conversations_json",
        "markdown_file",
        "markdown_archive_zip",
        "runtime_native_session",
        "unknown_archive",
        "unknown"
      ]
    },
    "provider": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "account_scope": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
        }
      ]
    },
    "input_object_hash": {
      "$ref": "common-v1.schema.json#/$defs/sha256"
    },
    "input_size_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "received_at": {
      "$ref": "common-v1.schema.json#/$defs/timestamp"
    },
    "updated_at": {
      "$ref": "common-v1.schema.json#/$defs/timestamp"
    },
    "adapter": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version"
          ],
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_.:/-]{0,127}$"
            },
            "version": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_.:/-]{0,127}$"
            }
          }
        }
      ]
    },
    "source_schema_observed": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_.:/-]{0,127}$"
        }
      ]
    },
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "member_name",
          "member_hash",
          "size_bytes",
          "disposition",
          "reason_code"
        ],
        "properties": {
          "member_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[^/\\\\:][^\\\\:]*$"
          },
          "member_hash": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "common-v1.schema.json#/$defs/sha256"
              }
            ]
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "disposition": {
            "enum": [
              "parsed",
              "preserved_only",
              "quarantined",
              "skipped"
            ]
          },
          "reason_code": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "common-v1.schema.json#/$defs/code"
              }
            ]
          }
        }
      }
    },
    "cursor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit",
        "completed",
        "total"
      ],
      "properties": {
        "unit": {
          "enum": [
            "conversation",
            "file",
            "event"
          ]
        },
        "completed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "total": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          ]
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sources_created",
        "sources_revised",
        "sources_unchanged",
        "conversations",
        "branches",
        "missing_parents",
        "unparseable",
        "attachments_present",
        "attachments_missing",
        "attachments_external",
        "attachments_quarantined"
      ],
      "properties": {
        "sources_created": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sources_revised": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sources_unchanged": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "conversations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "branches": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "missing_parents": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unparseable": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "attachments_present": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "attachments_missing": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "attachments_external": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "attachments_quarantined": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "original_conversation_id",
          "message_count",
          "branch_count",
          "earliest_source_time",
          "latest_source_time",
          "unknown_time_count",
          "missing_parents",
          "unparseable"
        ],
        "properties": {
          "original_conversation_id": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string"
              }
            ]
          },
          "message_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "branch_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "earliest_source_time": {
            "$ref": "common-v1.schema.json#/$defs/timestampOrNull"
          },
          "latest_source_time": {
            "$ref": "common-v1.schema.json#/$defs/timestampOrNull"
          },
          "unknown_time_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "missing_parents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "unparseable": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "common-v1.schema.json#/$defs/warning"
      }
    },
    "duplicate_of": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "common-v1.schema.json#/$defs/importId"
        }
      ]
    },
    "extensions": {
      "$ref": "common-v1.schema.json#/$defs/extensions"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "parsing",
              "completed"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "adapter": {
            "type": "object"
          }
        }
      }
    }
  ]
}
