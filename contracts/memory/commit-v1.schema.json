{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.enouia-memory.invalid/memory/commit-v1.schema.json",
  "title": "Enouia CommitManifest v1",
  "description": "Complete catalog of logical records at one commit. A commit is published by one CURRENT replacement in MV-1; this schema cannot prove atomicity or durability. Chain, epochs, idempotency, and catalog closure are cross-record rules.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "commit_id",
    "format_version",
    "parent_commit_id",
    "sequence",
    "vault_id",
    "writer_device_id",
    "principal",
    "operation_id",
    "operation_kind",
    "idempotency_key_hash",
    "request_payload_hash",
    "created_at",
    "catalog",
    "objects",
    "review_ids",
    "tombstone_ids",
    "policy_epoch",
    "deletion_epoch",
    "receipt"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common-v1.schema.json#/$defs/schemaVersion"
    },
    "commit_id": {
      "$ref": "common-v1.schema.json#/$defs/commitId"
    },
    "format_version": {
      "const": 1
    },
    "parent_commit_id": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "common-v1.schema.json#/$defs/commitId"
        }
      ]
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "vault_id": {
      "$ref": "common-v1.schema.json#/$defs/vaultId"
    },
    "writer_device_id": {
      "$ref": "common-v1.schema.json#/$defs/deviceId"
    },
    "principal": {
      "$ref": "common-v1.schema.json#/$defs/actorRef"
    },
    "operation_id": {
      "$ref": "common-v1.schema.json#/$defs/operationId"
    },
    "operation_kind": {
      "enum": [
        "genesis",
        "import",
        "candidate_propose",
        "review_commit",
        "identity_review",
        "session_append",
        "checkpoint_propose",
        "logical_delete",
        "purge",
        "policy_change",
        "migration",
        "restore_adopt"
      ]
    },
    "idempotency_key_hash": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "common-v1.schema.json#/$defs/sha256"
        }
      ]
    },
    "request_payload_hash": {
      "$ref": "common-v1.schema.json#/$defs/sha256"
    },
    "created_at": {
      "$ref": "common-v1.schema.json#/$defs/timestamp"
    },
    "catalog": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "record_kind",
          "record_id",
          "revision",
          "content_hash",
          "changed"
        ],
        "properties": {
          "record_kind": {
            "$ref": "common-v1.schema.json#/$defs/recordKind"
          },
          "record_id": {
            "type": "string",
            "pattern": "^[a-z]+_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "revision": {
            "$ref": "common-v1.schema.json#/$defs/revision"
          },
          "content_hash": {
            "$ref": "common-v1.schema.json#/$defs/sha256"
          },
          "changed": {
            "type": "boolean"
          }
        }
      }
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "object_hash",
          "size_bytes",
          "object_kind"
        ],
        "properties": {
          "object_hash": {
            "$ref": "common-v1.schema.json#/$defs/sha256"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "object_kind": {
            "enum": [
              "raw",
              "asset",
              "session_content",
              "identity_markdown"
            ]
          }
        }
      }
    },
    "review_ids": {
      "type": "array",
      "items": {
        "$ref": "common-v1.schema.json#/$defs/reviewId"
      }
    },
    "tombstone_ids": {
      "type": "array",
      "items": {
        "$ref": "common-v1.schema.json#/$defs/deleteId"
      }
    },
    "policy_epoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "deletion_epoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "result",
        "records"
      ],
      "properties": {
        "operation_id": {
          "$ref": "common-v1.schema.json#/$defs/operationId"
        },
        "result": {
          "const": "committed"
        },
        "records": {
          "type": "array",
          "items": {
            "$ref": "common-v1.schema.json#/$defs/recordRef"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operation_kind": {
            "enum": [
              "genesis"
            ]
          }
        },
        "required": [
          "operation_kind"
        ]
      },
      "then": {
        "properties": {
          "parent_commit_id": {
            "type": "null"
          },
          "sequence": {
            "const": 1
          },
          "idempotency_key_hash": {
            "type": "null"
          },
          "principal": {
            "$ref": "common-v1.schema.json#/$defs/ownerRef"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation_kind": {
            "not": {
              "const": "genesis"
            }
          }
        },
        "required": [
          "operation_kind"
        ]
      },
      "then": {
        "properties": {
          "parent_commit_id": {
            "$ref": "common-v1.schema.json#/$defs/commitId"
          },
          "idempotency_key_hash": {
            "$ref": "common-v1.schema.json#/$defs/sha256"
          },
          "sequence": {
            "minimum": 2
          }
        }
      }
    }
  ]
}
