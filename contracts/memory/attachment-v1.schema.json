{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.enouia-memory.invalid/memory/attachment-v1.schema.json",
  "title": "Enouia AttachmentRecord v1",
  "description": "Only 'present' carries a verified object hash. URLs are inert references, never fetched automatically.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "attachment_id",
    "revision",
    "source_id",
    "original_name",
    "claimed_media_type",
    "detected_media_type",
    "size_bytes",
    "object_hash",
    "availability",
    "external_reference",
    "sensitivity",
    "created_at",
    "extensions"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common-v1.schema.json#/$defs/schemaVersion"
    },
    "attachment_id": {
      "$ref": "common-v1.schema.json#/$defs/attachmentId"
    },
    "revision": {
      "$ref": "common-v1.schema.json#/$defs/revision"
    },
    "source_id": {
      "$ref": "common-v1.schema.json#/$defs/sourceId"
    },
    "original_name": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string"
        }
      ]
    },
    "claimed_media_type": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "detected_media_type": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "size_bytes": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      ]
    },
    "object_hash": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "common-v1.schema.json#/$defs/sha256"
        }
      ]
    },
    "availability": {
      "enum": [
        "present",
        "missing",
        "external_reference",
        "quarantined",
        "unsupported"
      ]
    },
    "external_reference": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "sensitivity": {
      "$ref": "common-v1.schema.json#/$defs/sensitivity"
    },
    "created_at": {
      "$ref": "common-v1.schema.json#/$defs/timestamp"
    },
    "extensions": {
      "$ref": "common-v1.schema.json#/$defs/extensions"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "availability": {
            "enum": [
              "present"
            ]
          }
        },
        "required": [
          "availability"
        ]
      },
      "then": {
        "properties": {
          "object_hash": {
            "$ref": "common-v1.schema.json#/$defs/sha256"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "availability": {
            "enum": [
              "missing",
              "external_reference",
              "quarantined",
              "unsupported"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "object_hash": {
            "type": "null"
          },
          "size_bytes": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "availability": {
            "enum": [
              "external_reference"
            ]
          }
        },
        "required": [
          "availability"
        ]
      },
      "then": {
        "properties": {
          "external_reference": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}
