{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.enouia-memory.invalid/memory/approval-v1.schema.json",
  "title": "Enouia ApprovalRecord v1",
  "description": "Owner approval that is not a memory review: egress of an exact request, declassification of an exact revision, or a policy grant. Egress approvals expire within 15 minutes and are single-use; binding checks are enforced by the Rust set validator.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "approval_id",
    "approved_by",
    "trusted_surface",
    "approval_nonce",
    "approved_diff_hash",
    "issued_at",
    "expires_at",
    "binding"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common-v1.schema.json#/$defs/schemaVersion"
    },
    "approval_id": {
      "$ref": "common-v1.schema.json#/$defs/approvalId"
    },
    "approved_by": {
      "$ref": "common-v1.schema.json#/$defs/ownerRef"
    },
    "trusted_surface": {
      "$ref": "common-v1.schema.json#/$defs/trustedSurface"
    },
    "approval_nonce": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{22,128}$"
    },
    "approved_diff_hash": {
      "$ref": "common-v1.schema.json#/$defs/sha256"
    },
    "issued_at": {
      "$ref": "common-v1.schema.json#/$defs/timestamp"
    },
    "expires_at": {
      "$ref": "common-v1.schema.json#/$defs/timestampOrNull"
    },
    "binding": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "request_id",
            "capsule_id",
            "payload_hash",
            "destination",
            "resources",
            "policy_id",
            "policy_epoch"
          ],
          "properties": {
            "kind": {
              "const": "egress"
            },
            "request_id": {
              "$ref": "common-v1.schema.json#/$defs/requestId"
            },
            "capsule_id": {
              "$ref": "common-v1.schema.json#/$defs/capsuleId"
            },
            "payload_hash": {
              "$ref": "common-v1.schema.json#/$defs/sha256"
            },
            "destination": {
              "$ref": "../context/common-v1.schema.json#/$defs/destination"
            },
            "resources": {
              "type": "array",
              "items": {
                "$ref": "common-v1.schema.json#/$defs/recordRef"
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "policy_id": {
              "$ref": "common-v1.schema.json#/$defs/policyId"
            },
            "policy_epoch": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "target",
            "from_sensitivity",
            "to_sensitivity",
            "source_refs",
            "final_content_hash"
          ],
          "properties": {
            "kind": {
              "const": "declassification"
            },
            "target": {
              "$ref": "common-v1.schema.json#/$defs/recordRef"
            },
            "from_sensitivity": {
              "$ref": "common-v1.schema.json#/$defs/sensitivity"
            },
            "to_sensitivity": {
              "$ref": "common-v1.schema.json#/$defs/sensitivity"
            },
            "source_refs": {
              "type": "array",
              "items": {
                "$ref": "common-v1.schema.json#/$defs/sourceRevisionRef"
              },
              "minItems": 1
            },
            "final_content_hash": {
              "$ref": "common-v1.schema.json#/$defs/sha256"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "policy_id",
            "policy_revision",
            "grant_hash"
          ],
          "properties": {
            "kind": {
              "const": "policy_grant"
            },
            "policy_id": {
              "$ref": "common-v1.schema.json#/$defs/policyId"
            },
            "policy_revision": {
              "$ref": "common-v1.schema.json#/$defs/revision"
            },
            "grant_hash": {
              "$ref": "common-v1.schema.json#/$defs/sha256"
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "binding": {
            "properties": {
              "kind": {
                "const": "egress"
              }
            },
            "required": [
              "kind"
            ]
          }
        },
        "required": [
          "binding"
        ]
      },
      "then": {
        "properties": {
          "expires_at": {
            "$ref": "common-v1.schema.json#/$defs/timestamp"
          }
        }
      }
    }
  ]
}
