{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.enouia-memory.invalid/store/restore-state-v1.schema.json",
  "title": "Enouia restore state v1",
  "description": "config/restore-state.json: network, Provider, MCP, and sync stay disabled until the owner reconciles newer deletions and revocations.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "vault_id",
    "restored_commit_id",
    "export_manifest_sha256",
    "restored_at",
    "network_disabled_until_reconciled",
    "reconciled_at"
  ],
  "properties": {
    "schema_version": {
      "$ref": "../memory/common-v1.schema.json#/$defs/schemaVersion"
    },
    "vault_id": {
      "$ref": "../memory/common-v1.schema.json#/$defs/vaultId"
    },
    "restored_commit_id": {
      "$ref": "../memory/common-v1.schema.json#/$defs/commitId"
    },
    "export_manifest_sha256": {
      "$ref": "../memory/common-v1.schema.json#/$defs/sha256"
    },
    "restored_at": {
      "$ref": "../memory/common-v1.schema.json#/$defs/timestamp"
    },
    "network_disabled_until_reconciled": {
      "type": "boolean"
    },
    "reconciled_at": {
      "$ref": "../memory/common-v1.schema.json#/$defs/timestampOrNull"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "reconciled_at": {
            "type": "null"
          }
        },
        "required": [
          "reconciled_at"
        ]
      },
      "then": {
        "properties": {
          "network_disabled_until_reconciled": {
            "const": true
          }
        }
      }
    }
  ]
}
