{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.enouia-memory.invalid/store/export-manifest-v1.schema.json",
  "title": "Enouia pinned-commit export manifest v1",
  "description": "export-manifest.json at the root of a plaintext pinned-commit export that an encrypted backup tool stores. Path order, uniqueness, exclusions, and required files are checked by the Rust validator.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "export_format",
    "vault_id",
    "commit_id",
    "sequence",
    "policy_epoch",
    "deletion_epoch",
    "manifest_sha256",
    "created_at",
    "files"
  ],
  "properties": {
    "schema_version": {
      "$ref": "../memory/common-v1.schema.json#/$defs/schemaVersion"
    },
    "export_format": {
      "const": 2
    },
    "vault_id": {
      "$ref": "../memory/common-v1.schema.json#/$defs/vaultId"
    },
    "commit_id": {
      "$ref": "../memory/common-v1.schema.json#/$defs/commitId"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "policy_epoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "deletion_epoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "manifest_sha256": {
      "$ref": "../memory/common-v1.schema.json#/$defs/sha256"
    },
    "created_at": {
      "$ref": "../memory/common-v1.schema.json#/$defs/timestamp"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "size_bytes"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^vault(/[A-Za-z0-9_.-]+)+$",
            "$comment": "'.' and '..' segments and store bookkeeping paths are rejected by the Rust validator."
          },
          "sha256": {
            "$ref": "../memory/common-v1.schema.json#/$defs/sha256"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        }
      },
      "minItems": 2
    }
  }
}
