{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.enouia-memory.invalid/store/publish-record-v1.schema.json",
  "title": "Enouia publish journal line v1",
  "description": "One line of vault/journal/published.jsonl, appended after CURRENT was replaced: evidence for owner-driven recovery.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "vault_id",
    "commit_id",
    "sequence",
    "manifest_sha256",
    "published_at"
  ],
  "properties": {
    "schema_version": {
      "$ref": "../memory/common-v1.schema.json#/$defs/schemaVersion"
    },
    "vault_id": {
      "$ref": "../memory/common-v1.schema.json#/$defs/vaultId"
    },
    "commit_id": {
      "$ref": "../memory/common-v1.schema.json#/$defs/commitId"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "manifest_sha256": {
      "$ref": "../memory/common-v1.schema.json#/$defs/sha256"
    },
    "published_at": {
      "$ref": "../memory/common-v1.schema.json#/$defs/timestamp"
    }
  }
}
