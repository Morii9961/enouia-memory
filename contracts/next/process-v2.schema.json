{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.enouia-memory.invalid/next/process-v2.schema.json",
  "title": "Scoped native activity, changes and selected details; parsing is not authority",
  "oneOf": [
    {
      "$ref": "#/$defs/MemoryActivityPage"
    },
    {
      "$ref": "#/$defs/MemoryChanges"
    },
    {
      "$ref": "#/$defs/NativeMemoryDetail"
    },
    {
      "$ref": "#/$defs/MemoryConflictGroup"
    },
    {
      "$ref": "#/$defs/MemoryRevisionDiff"
    },
    {
      "$ref": "#/$defs/NativeMemoryNeighbors"
    },
    {
      "$ref": "#/$defs/NativeSourceExcerpt"
    },
    {
      "$ref": "#/$defs/NativeConversationPage"
    },
    {
      "$ref": "#/$defs/NativeConversationDetail"
    }
  ],
  "$defs": {
    "MemoryFormationReason": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interpretation",
        "rule_version",
        "prompt_version",
        "model_version",
        "mode",
        "import_batch_id",
        "note",
        "note_is_machine_annotation"
      ],
      "properties": {
        "interpretation": {
          "enum": [
            "clear_self_report",
            "inference",
            "ambiguous",
            "conflicting"
          ]
        },
        "rule_version": {
          "enum": [
            "admission-rules-1",
            "admission-rules-2",
            "admission-rules-3"
          ]
        },
        "prompt_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "model_version": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "mode": {
          "enum": [
            "backfill",
            "live"
          ]
        },
        "import_batch_id": {
          "oneOf": [
            {
              "$ref": "../memory/common-v1.schema.json#/$defs/importId"
            },
            {
              "type": "null"
            }
          ]
        },
        "note": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            {
              "type": "null"
            }
          ]
        },
        "note_is_machine_annotation": {
          "const": true
        }
      }
    },
    "ProcessHeader": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selection",
        "algorithm",
        "version",
        "parameters_hash",
        "permission_hash",
        "authorized_at",
        "scope"
      ],
      "properties": {
        "selection": {
          "$ref": "catalog-v2.schema.json#/$defs/selection"
        },
        "algorithm": {
          "enum": [
            "witnessed-native-activity-1",
            "authorized-native-changes-1",
            "authorized-native-detail-1",
            "recorded-counter-evidence-1",
            "structural-revision-diff-1",
            "typed-selected-neighbors-1",
            "selected-source-excerpt-1",
            "authorized-conversation-list-1",
            "authorized-conversation-turns-1"
          ]
        },
        "version": {
          "const": 1
        },
        "parameters_hash": {
          "$ref": "../memory/common-v1.schema.json#/$defs/sha256"
        },
        "permission_hash": {
          "$ref": "../memory/common-v1.schema.json#/$defs/sha256"
        },
        "authorized_at": {
          "$ref": "../memory/common-v1.schema.json#/$defs/timestamp"
        },
        "scope": {
          "const": "authorized_current_dependencies"
        }
      }
    },
    "ActivityQuery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "memory",
        "event_kind",
        "include_sources"
      ],
      "properties": {
        "memory": {
          "oneOf": [
            {
              "$ref": "../memory/common-v1.schema.json#/$defs/memoryId"
            },
            {
              "type": "null"
            }
          ]
        },
        "event_kind": {
          "oneOf": [
            {
              "$ref": "#/$defs/NativeActivityKind"
            },
            {
              "type": "null"
            }
          ]
        },
        "include_sources": {
          "type": "boolean"
        }
      }
    },
    "NativePublicationProof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit_id",
        "commit_hash",
        "actor",
        "written_at"
      ],
      "properties": {
        "commit_id": {
          "$ref": "../memory/common-v1.schema.json#/$defs/commitId"
        },
        "commit_hash": {
          "$ref": "../memory/common-v1.schema.json#/$defs/sha256"
        },
        "actor": {
          "$ref": "../memory/common-v1.schema.json#/$defs/actorRef"
        },
        "written_at": {
          "$ref": "../memory/common-v1.schema.json#/$defs/timestamp"
        }
      }
    },
    "MemoryActivityEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "event_kind",
        "memory",
        "source",
        "title",
        "change",
        "knowledge",
        "adoption",
        "effective_sensitivity",
        "formation_reason",
        "proof",
        "receipt"
      ],
      "properties": {
        "event_id": {
          "$ref": "../memory/common-v1.schema.json#/$defs/sha256"
        },
        "event_kind": {
          "$ref": "#/$defs/NativeActivityKind"
        },
        "memory": {
          "oneOf": [
            {
              "$ref": "automation-v2.schema.json#/$defs/memoryRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "oneOf": [
            {
              "$ref": "../memory/common-v1.schema.json#/$defs/sourceRevisionRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "title": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            },
            {
              "type": "null"
            }
          ]
        },
        "change": {
          "oneOf": [
            {
              "enum": [
                "initial",
                "update",
                "correction",
                "pause",
                "resume",
                "cancellation",
                "completion",
                "synthesis",
                "reversion"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "knowledge": {
          "oneOf": [
            {
              "enum": [
                "attributed_statement",
                "hypothesis",
                "uncertain",
                "disputed"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "adoption": {
          "oneOf": [
            {
              "enum": [
                "adopted",
                "staged"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "effective_sensitivity": {
          "$ref": "../memory/common-v1.schema.json#/$defs/sensitivity"
        },
        "formation_reason": {
          "oneOf": [
            {
              "$ref": "#/$defs/MemoryFormationReason"
            },
            {
              "type": "null"
            }
          ]
        },
        "proof": {
          "$ref": "#/$defs/NativePublicationProof"
        },
        "receipt": {
          "oneOf": [
            {
              "$ref": "storage-v2.schema.json#/$defs/receipt"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ActivityCursor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "header",
        "after_time",
        "after_id"
      ],
      "properties": {
        "header": {
          "$ref": "#/$defs/ProcessHeader"
        },
        "after_time": {
          "$ref": "../memory/common-v1.schema.json#/$defs/timestamp"
        },
        "after_id": {
          "$ref": "../memory/common-v1.schema.json#/$defs/sha256"
        }
      }
    },
    "MemoryActivityPage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "capability",
        "effect",
        "header",
        "matched_in_scope",
        "items",
        "next",
        "complete_in_scope",
        "time_derived_events_available"
      ],
      "properties": {
        "schema_version": {
          "const": 2
        },
        "kind": {
          "const": "memory_activity_page"
        },
        "capability": {
          "const": "memory-native-read-2"
        },
        "effect": {
          "const": "native_read"
        },
        "header": {
          "$ref": "#/$defs/ProcessHeader"
        },
        "matched_in_scope": {
          "type": "integer",
          "minimum": 0,
          "maximum": 131072
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MemoryActivityEvent"
          },
          "maxItems": 100
        },
        "next": {
          "oneOf": [
            {
              "$ref": "#/$defs/ActivityCursor"
            },
            {
              "type": "null"
            }
          ]
        },
        "complete_in_scope": {
          "type": "boolean"
        },
        "time_derived_events_available": {
          "const": false
        }
      }
    },
    "ChangeAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot",
        "permission_hash",
        "query_hash"
      ],
      "properties": {
        "snapshot": {
          "$ref": "automation-v2.schema.json#/$defs/snapshot"
        },
        "permission_hash": {
          "$ref": "../memory/common-v1.schema.json#/$defs/sha256"
        },
        "query_hash": {
          "$ref": "../memory/common-v1.schema.json#/$defs/sha256"
        }
      }
    },
    "MemoryChanges": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "capability",
        "effect",
        "header",
        "status",
        "next_anchor",
        "memories",
        "sources",
        "all_projections_invalidated",
        "complete_in_scope"
      ],
      "properties": {
        "schema_version": {
          "const": 2
        },
        "kind": {
          "const": "memory_changes"
        },
        "capability": {
          "const": "memory-native-read-2"
        },
        "effect": {
          "const": "native_read"
        },
        "header": {
          "$ref": "#/$defs/ProcessHeader"
        },
        "status": {
          "$ref": "#/$defs/ChangeStatus"
        },
        "next_anchor": {
          "$ref": "#/$defs/ChangeAnchor"
        },
        "memories": {
          "type": "array",
          "items": {
            "$ref": "automation-v2.schema.json#/$defs/memoryRef"
          },
          "maxItems": 100
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "../memory/common-v1.schema.json#/$defs/sourceRevisionRef"
          },
          "maxItems": 100
        },
        "all_projections_invalidated": {
          "type": "boolean"
        },
        "complete_in_scope": {
          "const": true
        }
      }
    },
    "NativeRevisionSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "memory",
        "title",
        "knowledge",
        "adoption",
        "interpretation",
        "change",
        "learned_at",
        "effective_sensitivity",
        "receipt"
      ],
      "properties": {
        "memory": {
          "$ref": "automation-v2.schema.json#/$defs/targetRef"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "knowledge": {
          "enum": [
            "attributed_statement",
            "hypothesis",
            "uncertain",
            "disputed"
          ]
        },
        "adoption": {
          "enum": [
            "adopted",
            "staged"
          ]
        },
        "interpretation": {
          "enum": [
            "clear_self_report",
            "inference",
            "ambiguous",
            "conflicting"
          ]
        },
        "change": {
          "enum": [
            "initial",
            "update",
            "correction",
            "pause",
            "resume",
            "cancellation",
            "completion",
            "synthesis",
            "reversion"
          ]
        },
        "learned_at": {
          "$ref": "../memory/common-v1.schema.json#/$defs/timestamp"
        },
        "effective_sensitivity": {
          "$ref": "../memory/common-v1.schema.json#/$defs/sensitivity"
        },
        "receipt": {
          "$ref": "storage-v2.schema.json#/$defs/receipt"
        }
      }
    },
    "HistoryCursor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "header",
        "memory",
        "before_revision"
      ],
      "properties": {
        "header": {
          "$ref": "#/$defs/ProcessHeader"
        },
        "memory": {
          "$ref": "../memory/common-v1.schema.json#/$defs/memoryId"
        },
        "before_revision": {
          "$ref": "../memory/common-v1.schema.json#/$defs/revision"
        }
      }
    },
    "NativeMemoryDetail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "capability",
        "effect",
        "header",
        "item",
        "fields",
        "history",
        "history_count_in_scope",
        "next_history"
      ],
      "properties": {
        "schema_version": {
          "const": 2
        },
        "kind": {
          "const": "native_memory_detail"
        },
        "capability": {
          "const": "memory-native-read-2"
        },
        "effect": {
          "const": "native_read"
        },
        "header": {
          "$ref": "#/$defs/ProcessHeader"
        },
        "item": {
          "oneOf": [
            {
              "$ref": "catalog-v2.schema.json#/$defs/item"
            },
            {
              "type": "null"
            }
          ]
        },
        "fields": {
          "oneOf": [
            {
              "$ref": "ui-records-v2.schema.json#/$defs/memoryFields"
            },
            {
              "type": "null"
            }
          ]
        },
        "history": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NativeRevisionSummary"
          },
          "maxItems": 32
        },
        "history_count_in_scope": {
          "type": "integer",
          "minimum": 0,
          "maximum": 131072
        },
        "next_history": {
          "oneOf": [
            {
              "$ref": "#/$defs/HistoryCursor"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ConflictCursor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "header",
        "memory",
        "after"
      ],
      "properties": {
        "header": {
          "$ref": "#/$defs/ProcessHeader"
        },
        "memory": {
          "$ref": "../memory/common-v1.schema.json#/$defs/memoryId"
        },
        "after": {
          "$ref": "../memory/common-v1.schema.json#/$defs/memoryId"
        }
      }
    },
    "MemoryConflictGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "capability",
        "effect",
        "header",
        "selected",
        "basis",
        "counter_evidence",
        "matched_in_scope",
        "items",
        "next"
      ],
      "properties": {
        "schema_version": {
          "const": 2
        },
        "kind": {
          "const": "memory_conflict_group"
        },
        "capability": {
          "const": "memory-native-read-2"
        },
        "effect": {
          "const": "native_read"
        },
        "header": {
          "$ref": "#/$defs/ProcessHeader"
        },
        "selected": {
          "oneOf": [
            {
              "$ref": "automation-v2.schema.json#/$defs/memoryRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "basis": {
          "const": "recorded_counter_source_overlap_not_independent_verification"
        },
        "counter_evidence": {
          "type": "array",
          "items": {
            "$ref": "../memory/common-v1.schema.json#/$defs/sourceRevisionRef"
          },
          "maxItems": 128
        },
        "matched_in_scope": {
          "type": "integer",
          "minimum": 0,
          "maximum": 131072
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "catalog-v2.schema.json#/$defs/item"
          },
          "maxItems": 100
        },
        "next": {
          "oneOf": [
            {
              "$ref": "#/$defs/ConflictCursor"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "RevisionFieldDiff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "before",
        "after"
      ],
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "before": {},
        "after": {}
      }
    },
    "MemoryRevisionDiff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "capability",
        "effect",
        "header",
        "before",
        "after",
        "fields",
        "structural_only"
      ],
      "properties": {
        "schema_version": {
          "const": 2
        },
        "kind": {
          "const": "memory_revision_diff"
        },
        "capability": {
          "const": "memory-native-read-2"
        },
        "effect": {
          "const": "native_read"
        },
        "header": {
          "$ref": "#/$defs/ProcessHeader"
        },
        "before": {
          "oneOf": [
            {
              "$ref": "automation-v2.schema.json#/$defs/targetRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "after": {
          "oneOf": [
            {
              "$ref": "automation-v2.schema.json#/$defs/targetRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RevisionFieldDiff"
          },
          "maxItems": 16
        },
        "structural_only": {
          "const": true
        }
      }
    },
    "NativeNeighborRelation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relation",
        "class",
        "direction",
        "witnesses",
        "witness_count_in_scope",
        "witnesses_complete"
      ],
      "properties": {
        "relation": {
          "enum": [
            "derived_from",
            "reversion",
            "revises",
            "corrects",
            "same_entity",
            "same_conversation",
            "theme_cooccurrence"
          ]
        },
        "class": {
          "enum": [
            "recorded_relation",
            "algorithm_suggestion"
          ]
        },
        "direction": {
          "enum": [
            "incoming",
            "outgoing",
            "undirected"
          ]
        },
        "witnesses": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "maxItems": 128,
          "minItems": 1
        },
        "witness_count_in_scope": {
          "type": "integer",
          "minimum": 0,
          "maximum": 131072
        },
        "witnesses_complete": {
          "type": "boolean"
        }
      }
    },
    "NativeMemoryNeighbor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "other",
        "relations"
      ],
      "properties": {
        "other": {
          "$ref": "#/$defs/NativeRevisionSummary"
        },
        "relations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NativeNeighborRelation"
          },
          "maxItems": 7,
          "minItems": 1
        }
      }
    },
    "NeighborCursor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "header",
        "memory",
        "after"
      ],
      "properties": {
        "header": {
          "$ref": "#/$defs/ProcessHeader"
        },
        "memory": {
          "$ref": "../memory/common-v1.schema.json#/$defs/memoryId"
        },
        "after": {
          "$ref": "automation-v2.schema.json#/$defs/memoryRef"
        }
      }
    },
    "NativeMemoryNeighbors": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "capability",
        "effect",
        "header",
        "selected",
        "matched_in_scope",
        "items",
        "next"
      ],
      "properties": {
        "schema_version": {
          "const": 2
        },
        "kind": {
          "const": "native_memory_neighbors"
        },
        "capability": {
          "const": "memory-native-read-2"
        },
        "effect": {
          "const": "native_read"
        },
        "header": {
          "$ref": "#/$defs/ProcessHeader"
        },
        "selected": {
          "oneOf": [
            {
              "$ref": "automation-v2.schema.json#/$defs/targetRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "matched_in_scope": {
          "type": "integer",
          "minimum": 0,
          "maximum": 131072
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NativeMemoryNeighbor"
          },
          "maxItems": 100
        },
        "next": {
          "oneOf": [
            {
              "$ref": "#/$defs/NeighborCursor"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "NativeSourceMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference",
        "source_kind",
        "locator",
        "speaker",
        "author_label",
        "evidence_class",
        "original_conversation_id",
        "original_message_id",
        "original_time",
        "original_timezone",
        "occurred_at",
        "captured_at",
        "time_precision",
        "content_hash",
        "anchor_hash",
        "effective_sensitivity",
        "extensions",
        "extensions_are_untrusted_data"
      ],
      "properties": {
        "reference": {
          "$ref": "../memory/common-v1.schema.json#/$defs/sourceRevisionRef"
        },
        "source_kind": {
          "enum": [
            "export_message",
            "runtime_event",
            "imported_document",
            "manual_assertion",
            "external_event",
            "agent_submission"
          ]
        },
        "locator": {
          "$ref": "../memory/common-v1.schema.json#/$defs/locator"
        },
        "speaker": {
          "$ref": "../memory/common-v1.schema.json#/$defs/speakerRole"
