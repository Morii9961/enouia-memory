{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 2
    },
    "kind": {
      "const": "memory_job_journal"
    },
    "limits": {
      "$ref": "#/$defs/limits"
    },
    "reserved_tokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "reserved_cost_microusd": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "last_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "jobs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/job"
      },
      "minItems": 0,
      "maxItems": 16
    }
  },
  "required": [
    "schema_version",
    "kind",
    "limits",
    "reserved_tokens",
    "reserved_cost_microusd",
    "last_ms",
    "jobs"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.enouia-memory.invalid/next/job-journal-v2.schema.json",
  "$defs": {
    "limits": {
      "type": "object",
      "properties": {
        "max_jobs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "total_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "total_cost_microusd": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "call_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "call_cost_microusd": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "call_timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        },
        "max_result_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 262144
        }
      },
      "required": [
        "max_jobs",
        "total_tokens",
        "total_cost_microusd",
        "call_tokens",
        "call_cost_microusd",
        "call_timeout_ms",
        "max_result_bytes"
      ],
      "additionalProperties": false
    },
    "job": {
      "type": "object",
      "properties": {
        "key": {
          "$ref": "../memory/common-v1.schema.json#/$defs/sha256"
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "automation-v2.schema.json#/$defs/input"
          },
          "minItems": 1,
          "maxItems": 8
        },
        "state": {
          "enum": [
            "queued",
            "running",
            "generated",
            "cancelled",
            "invalidated",
            "outcome_unknown",
            "failed",
            "budget_blocked"
          ]
        },
        "cursor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "attempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "uncertain": {
          "type": "boolean"
        },
        "results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/result"
          },
          "minItems": 0,
          "maxItems": 8
        }
      },
      "required": [
        "key",
        "inputs",
        "state",
        "cursor",
        "attempts",
        "uncertain",
        "results"
      ],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_hash",
        "response_hash",
        "response_json"
      ],
      "properties": {
        "input_hash": {
          "$ref": "../memory/common-v1.schema.json#/$defs/sha256"
        },
        "response_hash": {
          "$ref": "../memory/common-v1.schema.json#/$defs/sha256"
        },
        "response_json": {
          "type": "string",
          "minLength": 1,
          "maxLength": 262144
        }
      }
    }
  }
}
