{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.enouia-memory.invalid/next/continuation-v2.schema.json",
  "oneOf": [
    {
      "$ref": "#/$defs/policy"
    },
    {
      "$ref": "#/$defs/journal"
    }
  ],
  "$defs": {
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 2
        },
        "kind": {
          "const": "continuous_generation_policy"
        },
        "policy_id": {
          "$ref": "../memory/common-v1.schema.json#/$defs/policyId"
        },
        "revision": {
          "$ref": "../memory/common-v1.schema.json#/$defs/revision"
        },
        "granted_by": {
          "$ref": "../memory/common-v1.schema.json#/$defs/ownerRef"
        },
        "system_actor": {
          "$ref": "automation-v2.schema.json#/$defs/systemActor"
        },
        "vault_id": {
          "$ref": "../memory/common-v1.schema.json#/$defs/vaultId"
        },
        "admission_policy": {
          "$ref": "automation-v2.schema.json#/$defs/policyRef"
        },
        "subject_id": {
          "$ref": "../memory/common-v1.schema.json#/$defs/subjectId"
        },
        "project_id": {
          "oneOf": [
            {
              "$ref": "../memory/common-v1.schema.json#/$defs/projectId"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_ids": {
          "type": "array",
          "items": {
            "$ref": "../memory/common-v1.schema.json#/$defs/sourceId"
          },
          "minItems": 1,
          "maxItems": 128
        },
        "producer_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "destination": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "api": {
              "enum": [
                "synthetic",
                "openai_responses",
                "anthropic_messages"
              ]
            },
            "model": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "adapter_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "required": [
            "api",
            "model",
            "adapter_version"
          ]
        },
        "max_sensitivity": {
          "enum": [
            "public",
            "normal",
            "private"
          ]
        },
        "call_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "call_cost_microusd": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "total_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "total_cost_microusd": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "active": {
          "type": "boolean"
        },
        "valid_from": {
          "$ref": "../memory/common-v1.schema.json#/$defs/timestamp"
        },
        "valid_until": {
          "$ref": "../memory/common-v1.schema.json#/$defs/timestamp"
        }
      },
      "required": [
        "schema_version",
        "kind",
        "policy_id",
        "revision",
        "granted_by",
        "system_actor",
        "vault_id",
        "admission_policy",
        "subject_id",
        "project_id",
        "source_ids",
        "producer_version",
        "destination",
        "max_sensitivity",
        "call_tokens",
        "call_cost_microusd",
        "total_tokens",
        "total_cost_microusd",
        "active",
        "valid_from",
        "valid_until"
      ]
    },
    "journal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 2
        },
        "kind": {
          "const": "continuous_generation_journal"
        },
        "vault_id": {
          "$ref": "../memory/common-v1.schema.json#/$defs/vaultId"
        },
        "owner": {
          "$ref": "../memory/common-v1.schema.json#/$defs/ownerRef"
        },
        "system_actor": {
          "$ref": "automation-v2.schema.json#/$defs/systemActor"
        },
        "policy": {
          "oneOf": [
            {
              "$ref": "#/$defs/policy"
            },
            {
              "type": "null"
            }
          ]
        },
        "policy_history": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/policy"
          },
          "minItems": 0,
          "maxItems": 64
        },
        "last_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "attempts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "work_key": {
                "$ref": "../memory/common-v1.schema.json#/$defs/sha256"
              },
              "operation_id": {
                "$ref": "../memory/common-v1.schema.json#/$defs/operationId"
              },
              "input_hash": {
                "$ref": "../memory/common-v1.schema.json#/$defs/sha256"
              },
              "policy": {
                "$ref": "automation-v2.schema.json#/$defs/policyRef"
              },
              "snapshot": {
                "$ref": "automation-v2.schema.json#/$defs/snapshot"
              },
              "state": {
                "enum": [
                  "running",
                  "complete",
                  "failed",
                  "outcome_unknown",
                  "revoked"
                ]
              },
              "reserved_tokens": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "reserved_cost_microusd": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "tokens_used": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "cost_microusd": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "response_hash": {
                "oneOf": [
                  {
                    "$ref": "../memory/common-v1.schema.json#/$defs/sha256"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "work_key",
              "operation_id",
              "input_hash",
              "policy",
              "snapshot",
              "state",
              "reserved_tokens",
              "reserved_cost_microusd",
              "tokens_used",
              "cost_microusd",
              "response_hash"
            ]
          },
          "minItems": 0,
          "maxItems": 64
        }
      },
      "required": [
        "schema_version",
        "kind",
        "vault_id",
        "owner",
        "system_actor",
        "policy",
        "policy_history",
        "last_ms",
        "attempts"
      ]
    }
  }
}
