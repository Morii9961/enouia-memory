{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.enouia-memory.invalid/next/agent-note-v1.schema.json",
  "title": "Optional Agent hint record or saved-hint receipt; no memory authority",
  "oneOf": [
    { "$ref": "#/$defs/record" },
    { "$ref": "#/$defs/receipt" }
  ],
  "$defs": {
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["note_key", "request_id", "request_hash", "principal", "scope_hash", "policy", "evidence", "note"],
      "properties": {
        "note_key": { "$ref": "../memory/common-v1.schema.json#/$defs/sha256" },
        "request_id": { "$ref": "../memory/common-v1.schema.json#/$defs/requestId" },
        "request_hash": { "$ref": "../memory/common-v1.schema.json#/$defs/sha256" },
        "principal": {
          "allOf": [
            { "$ref": "../memory/common-v1.schema.json#/$defs/actorRef" },
            { "properties": { "actor_type": { "const": "agent" } } }
          ]
        },
        "scope_hash": { "$ref": "../memory/common-v1.schema.json#/$defs/sha256" },
        "policy": { "$ref": "automation-v2.schema.json#/$defs/policyRef" },
        "evidence": {
          "allOf": [
            { "$ref": "ui-records-v2.schema.json#/$defs/quote" },
            { "properties": { "reference": { "properties": { "supports": { "const": "content" } } } } }
          ]
        },
        "note": { "type": "string", "minLength": 1, "maxLength": 2000 }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["note_key", "request_id", "request_hash", "committed_in", "state"],
      "properties": {
        "note_key": { "$ref": "../memory/common-v1.schema.json#/$defs/sha256" },
        "request_id": { "$ref": "../memory/common-v1.schema.json#/$defs/requestId" },
        "request_hash": { "$ref": "../memory/common-v1.schema.json#/$defs/sha256" },
        "committed_in": { "$ref": "../memory/common-v1.schema.json#/$defs/commitId" },
        "state": { "const": "hint_saved" }
      }
    }
  }
}
