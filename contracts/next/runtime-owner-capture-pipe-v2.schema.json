{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.enouia-memory.invalid/next/runtime-owner-capture-pipe-v2.schema.json",
  "oneOf": [
    {
      "$ref": "#/$defs/call"
    },
    {
      "$ref": "#/$defs/reply"
    }
  ],
  "$defs": {
    "mode": {
      "enum": [
        "write",
        "preflight",
        "status"
      ]
    },
    "error": {
      "enum": [
        "outcome_unknown",
        "permission_denied",
        "invalid_request",
        "capacity",
        "unavailable"
      ]
    },
    "call": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "request"
      ],
      "properties": {
        "mode": {
          "$ref": "#/$defs/mode"
        },
        "request": {
          "$ref": "runtime-owner-capture-v2.schema.json#/$defs/request"
        }
      }
    },
    "reply": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "request_id",
            "mode",
            "capture",
            "queue",
            "jobs",
            "error"
          ],
          "properties": {
            "request_id": {
              "$ref": "../memory/common-v1.schema.json#/$defs/requestId"
            },
            "mode": {
              "const": "preflight"
            },
            "capture": {
              "$ref": "runtime-owner-capture-v2.schema.json#/$defs/receipt"
            },
            "queue": {
              "type": "null"
            },
            "jobs": {
              "type": "null"
            },
            "error": {
              "type": "null"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "request_id",
            "mode",
            "capture",
            "queue",
            "jobs",
            "error"
          ],
          "properties": {
            "request_id": {
              "$ref": "../memory/common-v1.schema.json#/$defs/requestId"
            },
            "mode": {
              "const": "write"
            },
            "capture": {
              "$ref": "runtime-owner-capture-v2.schema.json#/$defs/receipt"
            },
            "queue": {
              "$ref": "runtime-owner-capture-v2.schema.json#/$defs/queueReceipt"
            },
            "jobs": {
              "type": "null"
            },
            "error": {
              "type": "null"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "request_id",
            "mode",
            "capture",
            "queue",
            "jobs",
            "error"
          ],
          "properties": {
            "request_id": {
              "$ref": "../memory/common-v1.schema.json#/$defs/requestId"
            },
            "mode": {
              "const": "status"
            },
            "capture": {
              "type": "null"
            },
            "queue": {
              "type": "null"
            },
            "jobs": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "job_key",
                  "state",
                  "receipts",
                  "refused"
                ],
                "properties": {
                  "job_key": {
                    "$ref": "../memory/common-v1.schema.json#/$defs/sha256"
                  },
                  "state": {
                    "enum": [
                      "queued",
                      "dispatched",
                      "forming",
                      "formed",
                      "no_memory",
                      "rejected",
                      "analysis_unknown"
                    ]
                  },
                  "receipts": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 32
                  },
                  "refused": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            },
            "error": {
              "type": "null"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "request_id",
            "mode",
            "capture",
            "queue",
            "jobs",
            "error"
          ],
          "properties": {
            "request_id": {
              "$ref": "../memory/common-v1.schema.json#/$defs/requestId"
            },
            "mode": {
              "const": "write"
            },
            "capture": {
              "$ref": "runtime-owner-capture-v2.schema.json#/$defs/receipt"
            },
            "queue": {
              "type": "null"
            },
            "jobs": {
              "type": "null"
            },
            "error": {
              "$ref": "#/$defs/error"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "request_id",
            "mode",
            "capture",
            "queue",
            "jobs",
            "error"
          ],
          "properties": {
            "request_id": {
              "$ref": "../memory/common-v1.schema.json#/$defs/requestId"
            },
            "mode": {
              "$ref": "#/$defs/mode"
            },
            "capture": {
              "type": "null"
            },
            "queue": {
              "type": "null"
            },
            "jobs": {
              "type": "null"
            },
            "error": {
              "$ref": "#/$defs/error"
            }
          }
        }
      ]
    }
  }
}
