{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.enouia-memory.invalid/next/mcp-session-start-wire-v1.schema.json",
  "$comment": "Exact successful session_start reply. Assert ID, URI and parsed text equality independently.",
  "$ref": "#/$defs/session_tool_response",
  "$defs": {
    "session_tool_response": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "$ref": "mcp-opening-wire-v1.schema.json#/$defs/request_id"
        },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "content": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "prefixItems": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "const": "text"
                    },
                    "text": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "type",
                    "text"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "const": "resource_link"
                    },
                    "uri": {
                      "type": "string",
                      "pattern": "^enouia-memory://recall/req_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                    },
                    "name": {
                      "const": "actual_recall"
                    },
                    "mimeType": {
                      "const": "application/json"
                    }
                  },
                  "required": [
                    "type",
                    "uri",
                    "name",
                    "mimeType"
                  ]
                }
              ]
            },
            "structuredContent": {
              "$ref": "mcp-session-start-v1.schema.json#/$defs/session_response"
            },
            "isError": {
              "const": false
            }
          },
          "required": [
            "content",
            "structuredContent",
            "isError"
          ]
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "result"
      ]
    }
  }
}
