      "properties": {
        "memory_id": {
          "$ref": "../memory/common-v1.schema.json#/$defs/memoryId"
        },
        "expected": {
          "oneOf": [
            {
              "$ref": "read-model-v2.schema.json#/$defs/page/properties/snapshot"
            },
            {
              "type": "null"
            }
          ]
        },
        "include_source_text": {
          "type": "boolean"
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 2048,
          "maximum": 262144
        }
      },
