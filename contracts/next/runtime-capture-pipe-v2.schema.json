{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://contracts.enouia-memory.invalid/next/runtime-capture-pipe-v2.schema.json",
  "oneOf":[{"$ref":"#/$defs/call"},{"$ref":"#/$defs/reply"}],
  "$defs":{
    "mode":{"enum":["write","preflight"]},
    "error":{"enum":["outcome_unknown","permission_denied","invalid_request","capacity","unavailable"]},
    "call":{"type":"object","additionalProperties":false,"required":["mode","request"],"properties":{
      "mode":{"$ref":"#/$defs/mode"},"request":{"$ref":"runtime-capture-v2.schema.json"}
    }},
    "receipt":{"type":"object","additionalProperties":false,
      "required":["schema_version","kind","capability","request_id","request_hash","producer","scope_hash","observed_in","sources","captured","preflight","replayed","formation_scheduled"],
      "properties":{
        "schema_version":{"const":2},"kind":{"const":"native_runtime_capture"},"capability":{"const":"memory-runtime-capture-native-1"},
        "request_id":{"$ref":"../memory/common-v1.schema.json#/$defs/requestId"},
        "request_hash":{"$ref":"../memory/common-v1.schema.json#/$defs/sha256"},
        "scope_hash":{"$ref":"../memory/common-v1.schema.json#/$defs/sha256"},
        "producer":{"type":"object","additionalProperties":false,"required":["actor_type","actor_id"],"properties":{
          "actor_type":{"const":"client"},"actor_id":{"$ref":"../memory/common-v1.schema.json#/$defs/principalId"}}},
        "observed_in":{"$ref":"automation-v2.schema.json#/$defs/snapshot"},
        "sources":{"type":"array","minItems":1,"maxItems":8,"uniqueItems":true,"items":{"$ref":"../memory/common-v1.schema.json#/$defs/sourceRevisionRef"}},
        "captured":{"type":"boolean"},"preflight":{"type":"boolean"},"replayed":{"type":"boolean"},"formation_scheduled":{"const":false}
      }
    },
    "reply":{"oneOf":[
      {"type":"object","additionalProperties":false,"required":["request_id","mode","capture","error"],"properties":{
        "request_id":{"$ref":"../memory/common-v1.schema.json#/$defs/requestId"},"mode":{"$ref":"#/$defs/mode"},"capture":{"$ref":"#/$defs/receipt"},"error":{"type":"null"}}},
      {"type":"object","additionalProperties":false,"required":["request_id","mode","capture","error"],"properties":{
        "request_id":{"$ref":"../memory/common-v1.schema.json#/$defs/requestId"},"mode":{"$ref":"#/$defs/mode"},"capture":{"type":"null"},"error":{"$ref":"#/$defs/error"}}}
    ]}
  }
}
