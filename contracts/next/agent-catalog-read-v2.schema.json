          "type": "integer",
          "minimum": 0,
          "maximum": 16384
        },
        "to_byte": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 16384
            },
            {
              "type": "null"
            }
          ]
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
