        },
        "excluded_returned": {
          "type": "integer",
          "minimum": 0,
          "maximum": 128
        },
        "complete": {
          "type": "boolean"
        },
        "reason_counts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "not_adopted": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65536
            },
            "conditions": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65536
            },
            "time_window": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65536
            },
            "validity": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65536
            },
            "archived": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65536
            },
            "no_cue": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65536
            },
            "budget": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65536
            }
          }
        }
      },
      "required": [
        "excluded_in_scope",
        "excluded_returned",
        "complete",
        "reason_counts"
      ]
    },
    "recall_data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "$ref": "../memory/common-v1.schema.json#/$defs/requestId"
        },
        "scope_hash": {
          "$ref": "../memory/common-v1.schema.json#/$defs/sha256"
        },
        "trace": {
          "$ref": "#/$defs/recall_trace"
        },
        "trace_coverage": {
          "$ref": "#/$defs/trace_coverage"
        },
        "rendered_context": {
          "type": "string",
          "maxLength": 65536
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/item"
          },
          "maxItems": 32
        },
        "complete_in_scope": {
          "type": "boolean"
        }
      },
      "required": [
        "request_id",
        "scope_hash",
        "trace",
        "trace_coverage",
        "rendered_context",
        "items",
        "complete_in_scope"
      ]
    },
    "search_args": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "filter": {
          "$ref": "catalog-v2.schema.json#/$defs/filter"
        },
        "cursor": {
          "oneOf": [
            {
              "$ref": "catalog-v2.schema.json#/$defs/cursor"
