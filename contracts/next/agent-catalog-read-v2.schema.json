        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 4096,
          "maximum": 262144
        }
      },
      "required": [
        "filter",
        "cursor",
        "limit",
        "max_bytes"
      ]
    },
    "read_args": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "memory_id": {
          "$ref": "../memory/common-v1.schema.json#/$defs/memoryId"
