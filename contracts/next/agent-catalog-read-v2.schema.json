        "snapshot",
        "authorized_at",
        "profile_hash",
        "item",
        "history",
        "sources",
        "source_read",
        "neighbors",
        "complete_in_scope"
      ]
    },
    "recall_trace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "attention-rank-1"
        },
        "snapshot": {
          "$ref": "automation-v2.schema.json#/$defs/snapshot"
        },
        "profile_hash": {
          "$ref": "../memory/common-v1.schema.json#/$defs/sha256"
        },
        "at": {
          "$ref": "../memory/common-v1.schema.json#/$defs/timestamp"
        },
        "authorized_at": {
          "$ref": "../memory/common-v1.schema.json#/$defs/timestamp"
        },
        "considered": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65536
        },
        "selected": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "memory": {
                "$ref": "automation-v2.schema.json#/$defs/memoryRef"
              },
              "attention": {
                "enum": [
                  "active",
                  "fading",
                  "archived",
                  "protected"
                ]
              },
              "score": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "reasons": {
                "type": "array",
                "items": {
                  "enum": [
                    "lexical",
                    "alias",
                    "conditions",
                    "time_window",
                    "protected",
                    "fresh",
                    "fading",
                    "historical_rescue"
                  ]
                },
                "maxItems": 8
              }
            },
            "required": [
              "memory",
              "attention",
              "score",
              "reasons"
            ]
          },
          "maxItems": 32
        },
        "excluded": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "$ref": "automation-v2.schema.json#/$defs/memoryRef"
              },
              {
                "enum": [
                  "not_adopted",
                  "conditions",
                  "time_window",
                  "validity",
                  "archived",
                  "no_cue",
                  "budget"
                ]
              }
            ],
            "minItems": 2,
            "maxItems": 2
          },
          "maxItems": 128
        },
        "rendered_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65536
        }
      },
      "required": [
        "algorithm",
        "snapshot",
        "profile_hash",
        "at",
        "authorized_at",
        "considered",
        "selected",
        "excluded",
        "rendered_bytes"
      ]
    },
    "trace_coverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "excluded_in_scope": {
          "type": "integer",
          "minimum": 0,
