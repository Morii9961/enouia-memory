        "intent": {
          "enum": [
            "current",
            "historical",
            "browse"
          ]
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
