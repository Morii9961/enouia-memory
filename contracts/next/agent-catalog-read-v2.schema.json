{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.enouia-memory.invalid/next/agent-catalog-read-v2.schema.json",
  "oneOf": [
    {
      "$ref": "#/$defs/search_request"
    },
    {
      "$ref": "#/$defs/search_response"
    },
    {
      "$ref": "#/$defs/read_request"
    },
    {
      "$ref": "#/$defs/read_response"
    },
    {
      "$ref": "#/$defs/source_request"
    },
    {
      "$ref": "#/$defs/source_response"
    },
    {
      "$ref": "#/$defs/related_request"
    },
    {
      "$ref": "#/$defs/related_response"
    },
    {
      "$ref": "#/$defs/recall_request"
    },
    {
      "$ref": "#/$defs/recall_response"
    }
  ],
  "$defs": {
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "actor_type": {
          "const": "agent"
        },
        "actor_id": {
          "$ref": "../memory/common-v1.schema.json#/$defs/principalId"
        }
      },
      "required": [
        "actor_type",
        "actor_id"
      ]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "invalid_request",
            "permission_denied",
            "stale_scope",
            "unavailable",
            "outcome_unknown"
          ]
        },
        "retryable": {
          "const": false
        }
      },
      "required": [
        "code",
        "retryable"
      ]
    },
    "coverage": {
      "const": {
        "record_fields": "ui-records-v2",
        "graph": "recorded_provenance_only",
        "trace_exclusions": "bounded_128_with_exact_reason_counts",
        "owner_actions": "unavailable",
        "capture": "runtime_only_future"
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "base": {
          "$ref": "read-model-v2.schema.json#/$defs/item"
        },
        "record": {
          "$ref": "agent-record-read-v2.schema.json#/$defs/record_projection"
        }
      },
      "required": [
        "base",
        "record"
      ]
    },
    "search_data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "selection": {
          "$ref": "catalog-v2.schema.json#/$defs/selection"
        },
        "authorized_at": {
          "$ref": "../memory/common-v1.schema.json#/$defs/timestamp"
        },
        "matched_in_scope": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65536
        },
        "unknown_time_in_scope": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65536
        },
        "count_exact": {
          "const": true
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/item"
          },
          "maxItems": 100
        },
        "complete_in_scope": {
          "type": "boolean"
        },
        "next": {
          "oneOf": [
            {
              "$ref": "catalog-v2.schema.json#/$defs/cursor"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "selection",
        "authorized_at",
        "matched_in_scope",
        "unknown_time_in_scope",
        "count_exact",
        "items",
        "complete_in_scope",
        "next"
      ]
    },
    "source_data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "snapshot": {
          "$ref": "read-model-v2.schema.json#/$defs/page/properties/snapshot"
        },
        "authorized_at": {
          "$ref": "../memory/common-v1.schema.json#/$defs/timestamp"
        },
        "record": {
          "$ref": "../memory/source-v1.schema.json"
        },
        "attributed_subject": {
          "oneOf": [
            {
              "$ref": "../memory/common-v1.schema.json#/$defs/subjectId"
            },
            {
              "type": "null"
            }
          ]
        },
        "excerpt": {
          "type": "string",
          "maxLength": 8192
        },
        "excerpt_hash": {
          "$ref": "../memory/common-v1.schema.json#/$defs/sha256"
        },
        "from_byte": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16384
        },
        "to_byte": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16384
        },
        "full_byte_len": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16384
        },
        "complete": {
          "type": "boolean"
        },
        "next_start": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 16384
            },
            {
              "type": "null"
            }
          ]
        },
        "record_fields": {
          "$ref": "ui-records-v2.schema.json#/$defs/sourceFields"
        }
      },
      "required": [
        "snapshot",
        "authorized_at",
        "record",
        "attributed_subject",
        "excerpt",
        "excerpt_hash",
        "from_byte",
        "to_byte",
        "full_byte_len",
        "complete",
        "next_start",
        "record_fields"
      ]
    },
    "related_data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "snapshot": {
          "$ref": "read-model-v2.schema.json#/$defs/page/properties/snapshot"
        },
        "memory": {
          "$ref": "automation-v2.schema.json#/$defs/memoryRef"
        },
        "provenance_edges": {
          "$ref": "read-model-v2.schema.json#/$defs/detail/properties/neighbors"
        },
        "fact_edges": {
          "type": "array",
          "maxItems": 0
        },
        "suggested_edges": {
          "type": "array",
          "maxItems": 0
        },
        "unavailable": {
          "const": [
            "fact_edges",
            "suggested_edges"
          ]
        },
        "complete_in_scope": {
          "type": "boolean"
        }
      },
      "required": [
        "snapshot",
        "memory",
        "provenance_edges",
        "fact_edges",
        "suggested_edges",
        "unavailable",
        "complete_in_scope"
      ]
    },
    "detail_source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "record": {
          "$ref": "../memory/source-v1.schema.json"
        },
        "record_fields": {
          "$ref": "ui-records-v2.schema.json#/$defs/sourceFields"
        },
        "attributed_subject": {
          "oneOf": [
            {
              "$ref": "../memory/common-v1.schema.json#/$defs/subjectId"
            },
            {
              "type": "null"
            }
          ]
        },
        "text": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 65536
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "record",
        "record_fields",
        "attributed_subject",
        "text"
      ]
    },
    "read_data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "snapshot": {
          "$ref": "automation-v2.schema.json#/$defs/snapshot"
        },
        "authorized_at": {
          "$ref": "../memory/common-v1.schema.json#/$defs/timestamp"
        },
        "profile_hash": {
          "$ref": "../memory/common-v1.schema.json#/$defs/sha256"
        },
        "item": {
          "$ref": "#/$defs/item"
        },
        "history": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/item"
          },
          "maxItems": 65536
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/detail_source"
          },
          "maxItems": 65536
        },
        "source_read": {
          "type": "boolean"
        },
        "neighbors": {
          "$ref": "read-model-v2.schema.json#/$defs/detail/properties/neighbors"
        },
        "complete_in_scope": {
          "type": "boolean"
        }
      },
