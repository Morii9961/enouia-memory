{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.enouia-memory.invalid/next/read-model-v2.schema.json",
  "oneOf": [
    {
      "$ref": "#/$defs/page"
    },
    {
      "$ref": "#/$defs/detail"
    },
    {
      "$ref": "#/$defs/simulation"
    }
  ],
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "memory": {
          "$ref": "automation-v2.schema.json#/$defs/memoryRef"
        },
        "system_actor": {
          "$ref": "automation-v2.schema.json#/$defs/systemActor"
        },
        "subject_id": {
          "$ref": "../memory/common-v1.schema.json#/$defs/subjectId"
        },
        "project_id": {
          "oneOf": [
            {
              "$ref": "../memory/common-v1.schema.json#/$defs/projectId"
            },
            {
              "type": "null"
            }
          ]
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "knowledge": {
          "enum": [
            "attributed_statement",
            "hypothesis",
            "uncertain",
            "disputed"
          ]
        },
        "adoption": {
          "enum": [
            "adopted",
            "staged"
          ]
        },
        "dimensions": {
          "$ref": "formation-v2.schema.json"
        },
        "policy": {
          "$ref": "automation-v2.schema.json#/$defs/policyRef"
        },
        "rule_version": {
          "const": "admission-rules-3"
        },
        "committed_in": {
          "$ref": "../memory/common-v1.schema.json#/$defs/commitId"
        },
        "learned_at": {
          "$ref": "../memory/common-v1.schema.json#/$defs/timestamp"
        },
        "source_captured_at": {
          "$ref": "../memory/common-v1.schema.json#/$defs/timestamp"
        },
        "attention": {
          "enum": [
            "active",
            "fading",
            "archived",
            "protected"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "../memory/common-v1.schema.json#/$defs/evidenceRef"
          },
          "maxItems": 128
        },
        "context_source_refs": {
          "type": "array",
          "items": {
            "$ref": "../memory/common-v1.schema.json#/$defs/sourceRevisionRef"
          },
          "maxItems": 128
        },
        "receipt": {
          "oneOf": [
            {
              "$ref": "storage-v2.schema.json#/$defs/receipt"
            },
            {
              "type": "null"
            }
          ]
        },
        "validity": {
          "enum": [
            "unspecified",
            "in_range",
            "not_yet_valid",
            "expired"
          ]
        }
      },
      "required": [
        "memory",
        "system_actor",
        "subject_id",
        "project_id",
        "content",
        "knowledge",
        "adoption",
        "dimensions",
        "policy",
        "rule_version",
        "committed_in",
        "learned_at",
        "source_captured_at",
        "attention",
        "evidence",
        "context_source_refs",
        "receipt",
        "validity"
      ]
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 2
        },
        "kind": {
          "const": "automation_memory_page"
        },
        "capability": {
          "const": "memory-native-read-1"
        },
        "effect": {
          "enum": [
            "native_read",
            "synthetic_fixture"
          ]
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "current_list": {
              "type": "boolean"
            },
            "selected_history": {
              "type": "boolean"
            },
            "source_details": {
              "type": "boolean"
            },
            "local_lineage": {
              "type": "boolean"
            },
            "read_simulation": {
              "type": "boolean"
            },
            "global_timeline": {
              "type": "boolean"
            },
            "global_graph": {
              "type": "boolean"
            },
            "saved_experiment": {
              "type": "boolean"
            },
            "legacy_owner_history": {
              "type": "boolean"
            },
            "vectors": {
              "type": "boolean"
            }
          },
          "required": [
            "current_list",
            "selected_history",
            "source_details",
            "local_lineage",
            "read_simulation",
            "global_timeline",
            "global_graph",
            "saved_experiment",
            "legacy_owner_history",
            "vectors"
          ]
        },
        "snapshot": {
          "$ref": "automation-v2.schema.json#/$defs/snapshot"
        },
        "authorized_at": {
          "$ref": "../memory/common-v1.schema.json#/$defs/timestamp"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/item"
          },
          "maxItems": 32
        },
        "matched_in_scope": {
          "type": "integer",
          "minimum": 0,
          "maximum": 128
        },
        "unknown_event_time_in_scope": {
          "type": "integer",
          "minimum": 0,
          "maximum": 128
        },
        "complete_in_scope": {
          "type": "boolean"
        },
        "next": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "snapshot": {
                  "$ref": "automation-v2.schema.json#/$defs/snapshot"
                },
                "filter_hash": {
                  "$ref": "../memory/common-v1.schema.json#/$defs/sha256"
                },
                "after": {
                  "$ref": "../memory/common-v1.schema.json#/$defs/memoryId"
                }
              },
              "required": [
                "snapshot",
                "filter_hash",
                "after"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "maintenance_worker_alive": {
          "type": "boolean"
        },
        "profile_hash": {
          "$ref": "../memory/common-v1.schema.json#/$defs/sha256"
        }
      },
      "required": [
        "schema_version",
        "kind",
        "capability",
        "effect",
        "capabilities",
        "snapshot",
        "authorized_at",
        "items",
        "matched_in_scope",
        "unknown_event_time_in_scope",
        "complete_in_scope",
        "next",
        "maintenance_worker_alive",
        "profile_hash"
      ]
    },
    "detail": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 2
        },
        "kind": {
          "const": "automation_memory_detail"
        },
        "capability": {
          "const": "memory-native-read-1"
        },
        "effect": {
          "enum": [
            "native_read",
            "synthetic_fixture"
          ]
        },
        "snapshot": {
          "$ref": "automation-v2.schema.json#/$defs/snapshot"
        },
        "authorized_at": {
          "$ref": "../memory/common-v1.schema.json#/$defs/timestamp"
        },
        "item": {
          "$ref": "#/$defs/item"
        },
        "history": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/item"
          },
          "maxItems": 128
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "record": {
                "$ref": "../memory/source-v1.schema.json"
              },
              "attributed_subject": {
                "oneOf": [
                  {
                    "$ref": "../memory/common-v1.schema.json#/$defs/subjectId"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "text": {
                "oneOf": [
                  {
                    "type": "string",
                    "maxLength": 16384
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "record",
              "attributed_subject",
              "text"
            ]
          },
          "maxItems": 128
        },
        "neighbors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "to": {
                "$ref": "automation-v2.schema.json#/$defs/targetRef"
              },
              "kind": {
                "enum": [
                  "derived_from",
                  "reversion"
                ]
              },
              "from": {
                "$ref": "automation-v2.schema.json#/$defs/memoryRef"
              }
            },
            "required": [
              "from",
              "to",
              "kind"
            ]
          },
          "maxItems": 32
        },
        "complete_in_scope": {
          "type": "boolean"
        },
        "profile_hash": {
          "$ref": "../memory/common-v1.schema.json#/$defs/sha256"
        }
      },
      "required": [
        "schema_version",
        "kind",
        "capability",
        "effect",
        "snapshot",
        "authorized_at",
        "item",
        "history",
        "sources",
        "neighbors",
        "complete_in_scope",
        "profile_hash"
      ]
    },
    "simulation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 2
        },
        "kind": {
          "const": "memory_recall_simulation"
        },
        "capability": {
          "const": "memory-native-read-1"
        },
        "effect": {
          "enum": [
            "native_read",
            "synthetic_fixture"
          ]
        },
        "trace": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "algorithm": {
              "const": "attention-rank-1"
            },
            "snapshot": {
              "$ref": "automation-v2.schema.json#/$defs/snapshot"
            },
            "profile_hash": {
              "$ref": "../memory/common-v1.schema.json#/$defs/sha256"
            },
            "at": {
              "$ref": "../memory/common-v1.schema.json#/$defs/timestamp"
            },
            "authorized_at": {
              "$ref": "../memory/common-v1.schema.json#/$defs/timestamp"
            },
            "considered": {
              "type": "integer",
              "minimum": 0,
              "maximum": 128
            },
            "selected": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "memory": {
                    "$ref": "automation-v2.schema.json#/$defs/memoryRef"
                  },
                  "attention": {
                    "enum": [
                      "active",
                      "fading",
                      "archived",
                      "protected"
                    ]
                  },
                  "score": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "reasons": {
                    "type": "array",
                    "items": {
                      "enum": [
                        "lexical",
                        "alias",
                        "conditions",
                        "time_window",
                        "protected",
                        "fresh",
                        "fading",
                        "historical_rescue"
                      ]
                    },
                    "maxItems": 8
                  }
                },
                "required": [
                  "memory",
                  "attention",
                  "score",
                  "reasons"
                ]
              },
              "maxItems": 32
            },
            "excluded": {
              "type": "array",
              "items": {
                "type": "array",
                "prefixItems": [
                  {
                    "$ref": "automation-v2.schema.json#/$defs/memoryRef"
                  },
                  {
                    "enum": [
                      "not_adopted",
                      "conditions",
                      "time_window",
                      "validity",
                      "archived",
                      "no_cue",
                      "budget"
                    ]
                  }
                ],
                "minItems": 2,
                "maxItems": 2
              },
              "maxItems": 128
            },
            "rendered_bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65536
            }
          },
          "required": [
            "algorithm",
            "snapshot",
            "profile_hash",
            "at",
            "authorized_at",
            "considered",
            "selected",
            "excluded",
            "rendered_bytes"
          ]
        },
        "rendered_context": {
          "type": "string",
          "maxLength": 65536
        }
      },
      "required": [
        "schema_version",
        "kind",
        "capability",
        "effect",
        "trace",
        "rendered_context"
      ]
    }
  }
}
