{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.enouia-memory.invalid/host/server-hello-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_version",
    "workspace_version",
    "vault_id",
    "compatibility_hash",
    "instance_id",
    "primary",
    "surface",
    "expires_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "protocol_version": {
      "const": 1
    },
    "workspace_version": {
      "const": 1
    },
    "vault_id": {
      "$ref": "../memory/common-v1.schema.json#/$defs/vaultId"
    },
    "compatibility_hash": {
      "$ref": "../memory/common-v1.schema.json#/$defs/sha256"
    },
    "instance_id": {
      "$ref": "../memory/common-v1.schema.json#/$defs/sha256"
    },
    "primary": {
      "$ref": "authority-v1.schema.json#/$defs/binding"
    },
    "surface": {
      "enum": [
        "workspace",
        "quick_search"
      ]
    },
    "expires_at": {
      "$ref": "../memory/common-v1.schema.json#/$defs/timestamp"
    }
  }
}
