{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "vault_id",
    "revision",
    "primary",
    "checkpoint",
    "phase",
    "promotions"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "vault_id": {
      "$ref": "../memory/common-v1.schema.json#/$defs/vaultId"
    },
    "revision": {
      "$ref": "../memory/common-v1.schema.json#/$defs/revision"
    },
    "primary": {
      "$ref": "#/$defs/binding"
    },
    "checkpoint": {
      "$ref": "#/$defs/checkpoint"
    },
    "phase": {
      "$ref": "#/$defs/phase"
    },
    "promotions": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/plan"
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.enouia-memory.invalid/host/authority-v1.schema.json",
  "title": "Host authority v1 (additive, not an existing Vault file)",
  "$comment": "Plan hashes, distinct target, receipt chains and phase/checkpoint bindings are Rust semantic rules. A parsed claim is not authentication or durable authority.",
  "$defs": {
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host_id",
        "primary_epoch"
      ],
      "properties": {
        "host_id": {
          "$ref": "../memory/common-v1.schema.json#/$defs/deviceId"
        },
        "primary_epoch": {
          "$ref": "../memory/common-v1.schema.json#/$defs/revision"
        }
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit_id",
        "commit_sequence",
        "snapshot_hash",
        "policy_epoch",
        "deletion_epoch"
      ],
      "properties": {
        "commit_id": {
          "$ref": "../memory/common-v1.schema.json#/$defs/commitId"
        },
        "commit_sequence": {
          "$ref": "../memory/common-v1.schema.json#/$defs/revision"
        },
        "snapshot_hash": {
          "$ref": "../memory/common-v1.schema.json#/$defs/sha256"
        },
        "policy_epoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "deletion_epoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vault_id",
        "operation_id",
        "source",
        "target_host",
        "base_revision",
        "checkpoint"
      ],
      "properties": {
        "vault_id": {
          "$ref": "../memory/common-v1.schema.json#/$defs/vaultId"
        },
        "operation_id": {
          "$ref": "../memory/common-v1.schema.json#/$defs/operationId"
        },
        "source": {
          "$ref": "#/$defs/binding"
        },
        "target_host": {
          "$ref": "../memory/common-v1.schema.json#/$defs/deviceId"
        },
        "base_revision": {
          "$ref": "../memory/common-v1.schema.json#/$defs/revision"
        },
        "checkpoint": {
          "$ref": "#/$defs/checkpoint"
        }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "intent",
        "plan_hash"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "intent": {
          "$ref": "#/$defs/intent"
        },
        "plan_hash": {
          "$ref": "../memory/common-v1.schema.json#/$defs/sha256"
        }
      }
    },
    "phase": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "const": "active"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "plan"
          ],
          "properties": {
            "state": {
              "const": "quiesced"
            },
            "plan": {
              "$ref": "#/$defs/plan"
            }
          }
        }
      ]
    }
  }
}
