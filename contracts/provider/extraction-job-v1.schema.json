{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "input_event_id",
    "input_hash",
    "prompt_version",
    "binding",
    "subject_id",
    "sources",
    "max_candidates",
    "max_pending",
    "state",
    "cursor",
    "candidates",
    "max_reserved_tokens",
    "max_reserved_cost_microusd"
  ],
  "properties": {
    "run_id": {
      "$ref": "../memory/common-v1.schema.json#/$defs/extractionRunId"
    },
    "input_event_id": {
      "$ref": "../memory/common-v1.schema.json#/$defs/eventId"
    },
    "input_hash": {
      "$ref": "../memory/common-v1.schema.json#/$defs/sha256"
    },
    "prompt_version": {
      "enum": ["extract-text-1", "extract-text-2"]
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model",
        "adapter_version"
      ],
      "properties": {
        "provider": {
          "enum": [
            "openai",
            "anthropic"
          ]
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "adapter_version": {
          "const": "text-http-1"
        }
      }
    },
    "subject_id": {
      "$ref": "../memory/common-v1.schema.json#/$defs/subjectId"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "content_hash",
          "start",
          "end",
          "snippet_hash"
        ],
        "properties": {
          "source": {
            "$ref": "../memory/common-v1.schema.json#/$defs/sourceRevisionRef"
          },
          "content_hash": {
            "$ref": "../memory/common-v1.schema.json#/$defs/sha256"
          },
          "start": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "end": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "snippet_hash": {
            "$ref": "../memory/common-v1.schema.json#/$defs/sha256"
          }
        }
      }
    },
    "max_candidates": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32
    },
    "max_pending": {
      "type": "integer",
      "minimum": 1,
      "maximum": 500
    },
    "state": {
      "enum": [
        "ready",
        "paused",
        "completed"
      ]
    },
    "cursor": {
      "type": "integer",
      "minimum": 0,
      "maximum": 32
    },
    "candidates": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "oneOf": [
          {
            "type": "null"
          },
          {
            "$ref": "../memory/common-v1.schema.json#/$defs/candidateId"
          }
        ]
      }
    },
    "max_reserved_tokens": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "max_reserved_cost_microusd": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.enouia-memory.invalid/provider/extraction-job-v1.schema.json",
  "title": "Bounded ExtractionJob v1"
}
