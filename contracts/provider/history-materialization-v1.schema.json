{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.enouia-memory.invalid/provider/history-materialization-v1.schema.json",
  "title": "Local history materialization admission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "import_id",
    "import_revision",
    "input_object_hash",
    "preview_plan_hash",
    "preview_commit_id",
    "messages_per_batch",
    "max_path_references",
    "batch_indices",
    "binding",
    "subject_id",
    "max_candidates",
    "max_pending",
    "max_reserved_tokens",
    "max_reserved_cost_microusd",
    "submission_key_hash"
  ],
  "properties": {
    "import_id": {
      "$ref": "../memory/common-v1.schema.json#/$defs/importId"
    },
    "import_revision": {
      "$ref": "../memory/common-v1.schema.json#/$defs/revision"
    },
    "input_object_hash": {
      "$ref": "../memory/common-v1.schema.json#/$defs/sha256"
    },
    "preview_plan_hash": {
      "$ref": "../memory/common-v1.schema.json#/$defs/sha256"
    },
    "preview_commit_id": {
      "$ref": "../memory/common-v1.schema.json#/$defs/commitId"
    },
    "messages_per_batch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 15
    },
    "max_path_references": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "batch_indices": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 99999
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model",
        "adapter_version"
      ],
      "properties": {
        "provider": {
          "enum": [
            "openai",
            "anthropic"
          ]
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "adapter_version": {
          "const": "text-http-1"
        }
      }
    },
    "subject_id": {
      "$ref": "../memory/common-v1.schema.json#/$defs/subjectId"
    },
    "max_candidates": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32
    },
    "max_pending": {
      "type": "integer",
      "minimum": 1,
      "maximum": 500
    },
    "max_reserved_tokens": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "max_reserved_cost_microusd": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "submission_key_hash": {
      "$ref": "../memory/common-v1.schema.json#/$defs/sha256"
    }
  }
}
