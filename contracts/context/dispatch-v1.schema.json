{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.enouia-memory.invalid/context/dispatch-v1.schema.json",
  "title": "Enouia Dispatch Record v1",
  "description": "What was actually sent: roles, byte hashes, carried capsule memories, tools, output configuration, and the egress barrier used. request_hash is SHA-256 of the canonical payload {payload_version, destination, messages, tools, output}; the Rust validator recomputes it. Keys and auth headers are never recorded.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dispatch_id",
    "capsule_id",
    "inspection_id",
    "request_id",
    "destination",
    "request_hash",
    "messages",
    "tools",
    "output",
    "egress",
    "state",
    "prepared_at",
    "sent_at",
    "completed_at"
  ],
  "properties": {
    "schema_version": {
      "$ref": "../memory/common-v1.schema.json#/$defs/schemaVersion"
    },
    "dispatch_id": {
      "$ref": "../memory/common-v1.schema.json#/$defs/dispatchId"
    },
    "capsule_id": {
      "$ref": "../memory/common-v1.schema.json#/$defs/capsuleId"
    },
    "inspection_id": {
      "$ref": "../memory/common-v1.schema.json#/$defs/inspectionId"
    },
    "request_id": {
      "$ref": "../memory/common-v1.schema.json#/$defs/requestId"
    },
    "destination": {
      "$ref": "common-v1.schema.json#/$defs/destination"
    },
    "request_hash": {
      "$ref": "../memory/common-v1.schema.json#/$defs/sha256"
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "content_hash",
          "size_bytes",
          "resource_refs"
        ],
        "properties": {
          "role": {
            "enum": [
              "system",
              "user",
              "assistant",
              "tool"
            ]
          },
          "content_hash": {
            "$ref": "../memory/common-v1.schema.json#/$defs/sha256"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "resource_refs": {
            "type": "array",
            "items": {
              "$ref": "../memory/common-v1.schema.json#/$defs/recordRef"
            }
          }
        }
      },
      "minItems": 1
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "definition_hash"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "definition_hash": {
            "$ref": "../memory/common-v1.schema.json#/$defs/sha256"
          }
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_output_tokens",
        "streaming"
      ],
      "properties": {
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "streaming": {
          "type": "boolean"
        }
      }
    },
    "egress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_epoch",
        "deletion_epoch",
        "egress_policy_id",
        "egress_approval_id",
        "checked_at"
      ],
      "properties": {
        "policy_epoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "deletion_epoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "egress_policy_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "../memory/common-v1.schema.json#/$defs/policyId"
            }
          ]
        },
        "egress_approval_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "../memory/common-v1.schema.json#/$defs/approvalId"
            }
          ]
        },
        "checked_at": {
          "$ref": "../memory/common-v1.schema.json#/$defs/timestamp"
        }
      }
    },
    "state": {
      "enum": [
        "prepared",
        "sent",
        "completed",
        "failed",
        "cancelled",
        "outcome_unknown"
      ]
    },
    "prepared_at": {
      "$ref": "../memory/common-v1.schema.json#/$defs/timestamp"
    },
    "sent_at": {
      "$ref": "../memory/common-v1.schema.json#/$defs/timestampOrNull"
    },
    "completed_at": {
      "$ref": "../memory/common-v1.schema.json#/$defs/timestampOrNull"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "sent",
              "completed",
              "outcome_unknown"
            ]
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "sent_at": {
            "$ref": "../memory/common-v1.schema.json#/$defs/timestamp"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "prepared",
              "cancelled"
            ]
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "sent_at": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "completed"
            ]
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "completed_at": {
            "$ref": "../memory/common-v1.schema.json#/$defs/timestamp"
          }
        }
      }
    }
  ]
}
