#!/bin/sh
# Nightly backup of the remote service's Vault (ADR-MEM-188).
# Install to /usr/local/bin/enouia-memory-nightly-backup (0755, root); run by
# enouia-memory-backup.service as root. It stops the service if it is running,
# exports and verifies the Vault as the service account into a new
# UTC-stamped directory, then starts the service again only if it had been
# running. A service left stopped (for example after an unknown outcome) stays
# stopped. Old exports are never removed here.
set -u
config=${1:-/etc/enouia-memory/remote.json}
dir=${2:-/var/lib/enouia-memory/backups}
service=enouia-memory-remote.service
active=0
if systemctl is-active --quiet "$service"; then
    active=1
    systemctl stop "$service" || exit 1
fi
runuser -u enouia -- /usr/local/bin/enouia-memory-remote backup "$config" "$dir"
status=$?
if [ "$active" = 1 ]; then
    systemctl start "$service" || status=1
fi
exit "$status"
